LGhost r1 (HomeOfVapourSynthEvolution/VapourSynth-LGhost, the only tag).
VapourBox task #98, docs/reports/task-98-per-thread-buffer-maps.

The filter is fmParallel and keeps scratch buffers per worker thread in
std::unordered_map<std::thread::id, ...> members of the filter instance. One
map (buffer) is filled from getFrame and read by every kernel with no lock at
all. Two threads starting their first frame of an instance together corrupt
the map or lose an insert, and the kernel's .at() then throws
std::out_of_range inside a noexcept function: std::terminate, so vspipe aborts
("unordered_map::at: key not found"; on Windows the UCRT's abort is a
fail-fast, exit 0xC0000409). Measured on an M1 with 8 threads: one graph of
1000 instances aborted in 20 of 20 runs; with the patch, none in 40.

The patch locks the map: getFrame checks for the thread's buffers under a
shared lock and allocates them under a unique lock (only the calling thread
inserts its own key), and the kernels look them up through threadBuffer(),
under the shared lock. The buffers, their reuse and so the output are
unchanged, sample for sample. It also appends "(VapourBox: locked per-thread
buffers, task #98)" to the plugin's name, which is how a test and the deps
scripts recognise a patched build. No upstream release fixes this.

Made by docs/reports/task-98-per-thread-buffer-maps/scripts/make_patches.py
and applied by download-deps-{macos,linux}.sh and download-deps-windows.ps1
right after the clone; each build fails if it stops applying.

diff --git a/LGhost/LGhost.cpp b/LGhost/LGhost.cpp
index 179d353..e0c79a2 100644
--- a/LGhost/LGhost.cpp
+++ b/LGhost/LGhost.cpp
@@ -35,8 +35,7 @@ template<typename pixel_t>
 static void filter_c(const VSFrameRef * src, VSFrameRef * dst, const LGhostData * const VS_RESTRICT d, const VSAPI * vsapi) noexcept {
     using var_t = std::conditional_t<std::is_integral_v<pixel_t>, int, float>;
 
-    const auto threadId = std::this_thread::get_id();
-    var_t * buffer = reinterpret_cast<var_t *>(d->buffer.at(threadId).get());
+    var_t * buffer = reinterpret_cast<var_t *>(d->threadBuffer(d->buffer));
 
     for (int plane = 0; plane < d->vi->format->numPlanes; plane++) {
         if (d->process[plane]) {
@@ -95,7 +94,13 @@ static const VSFrameRef * VS_CC lghostGetFrame(int n, int activationReason, void
         try {
             auto threadId = std::this_thread::get_id();
 
-            if (!d->buffer.count(threadId)) {
+            bool known;
+            {
+                std::shared_lock<std::shared_mutex> lock(d->bufferMutex);
+                known = d->buffer.count(threadId);
+            }
+            if (!known) {
+                std::unique_lock<std::shared_mutex> lock(d->bufferMutex);
                 float * buffer = vs_aligned_malloc<float>((d->vi->width + 15) * sizeof(float), 64);
                 if (!buffer)
                     throw "malloc failure (buffer)";
@@ -264,7 +269,7 @@ static void VS_CC lghostCreate(const VSMap * in, VSMap * out, void * userData, V
 // Init
 
 VS_EXTERNAL_API(void) VapourSynthPluginInit(VSConfigPlugin configFunc, VSRegisterFunction registerFunc, VSPlugin * plugin) {
-    configFunc("com.holywu.lghost", "lghost", "Ghost Reduction", VAPOURSYNTH_API_VERSION, 1, plugin);
+    configFunc("com.holywu.lghost", "lghost", "Ghost Reduction (VapourBox: locked per-thread buffers, task #98)", VAPOURSYNTH_API_VERSION, 1, plugin);
     registerFunc("LGhost",
                  "clip:clip;"
                  "mode:int[];"
diff --git a/LGhost/LGhost.h b/LGhost/LGhost.h
index 2825a7d..ae1b0ad 100644
--- a/LGhost/LGhost.h
+++ b/LGhost/LGhost.h
@@ -1,6 +1,8 @@
 #pragma once
 
 #include <memory>
+#include <mutex>
+#include <shared_mutex>
 #include <thread>
 #include <type_traits>
 #include <unordered_map>
@@ -25,6 +27,12 @@ struct LGhostData final {
     bool process[3];
     std::vector<OptionData> options[3][4];
     int peak;
+    mutable std::shared_mutex bufferMutex;
     std::unordered_map<std::thread::id, unique_float> buffer;
+    // The calling thread's buffer, looked up under bufferMutex (task #98).
+    template<typename M> auto threadBuffer(const M & m) const {
+        std::shared_lock<std::shared_mutex> lock(bufferMutex);
+        return m.at(std::this_thread::get_id()).get();
+    }
     void (*filter)(const VSFrameRef * src, VSFrameRef * dst, const LGhostData * const VS_RESTRICT d, const VSAPI * vsapi) noexcept;
 };
