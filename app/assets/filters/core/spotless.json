{
  "$schema": "https://vapourbox.app/schemas/filter-v1.json",
  "id": "spotless",
  "version": "1.0.0",
  "name": "SpotLess",
  "description": "Remove dust, dirt, and temporal spots from film",
  "longDescription": "Removes single-frame blemishes: dust specks, hairs and emulsion flecks that flash up for one frame and vanish. It compares each frame against its neighbours and replaces anything that is present in only one of them.\n\nUse it on scanned or telecined film, after deinterlacing. Because the test is temporal, fast or erratic motion can be read as a spot — if you see smearing or ghosting on movement, ease off the strength.",
  "category": "cleanup",
  "icon": "auto_fix_high",
  "order": 3,
  "dependencies": {
    "vs_plugins": [
      "libtemporalmedian.dll",
      "libmvtools.dll"
    ]
  },
  "methods": [
    {
      "id": "spotless",
      "name": "SpotLess",
      "description": "Motion-compensated temporal median for spot/dirt removal (live-action only)",
      "function": "spotless.SpotLess",
      "parameters": [
        "chroma",
        "rec",
        "blksize",
        "overlap",
        "pel"
      ]
    },
    {
      "id": "removeDirt",
      "name": "RemoveDirt (fast)",
      "description": "About six times faster for most of the benefit — the one to use on a long capture",
      "function": "removedirt.RestoreMotionBlocks",
      "parameters": [
        "rdNoise",
        "rdNoisy",
        "rdGmthreshold",
        "rdDist",
        "rdPostDenoise"
      ]
    }
  ],
  "parameters": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "ui": {
        "hidden": true
      }
    },
    "chroma": {
      "type": "boolean",
      "default": true,
      "optional": true,
      "ui": {
        "label": "Process Chroma",
        "description": "Include chroma planes in spot removal (disable to avoid ghost artifacts)",
        "visibleWhen": {
          "method": [
            "spotless"
          ]
        }
      }
    },
    "rec": {
      "type": "boolean",
      "default": false,
      "optional": true,
      "ui": {
        "label": "Recalculate Vectors",
        "description": "Refine motion vectors at finer block size for more precision (slower)",
        "visibleWhen": {
          "method": [
            "spotless"
          ]
        }
      }
    },
    "blksize": {
      "type": "integer",
      "default": 16,
      "min": 4,
      "max": 64,
      "step": 4,
      "optional": true,
      "ui": {
        "label": "Block Size",
        "description": "Block size for motion analysis (auto: 32 for 4K, 16 for HD, 8 for SD)",
        "widget": "slider",
        "advanced": true,
        "visibleWhen": {
          "method": [
            "spotless"
          ]
        }
      }
    },
    "overlap": {
      "type": "integer",
      "default": 8,
      "min": 0,
      "max": 32,
      "step": 2,
      "optional": true,
      "ui": {
        "label": "Overlap",
        "description": "Block overlap for motion analysis (default: half of block size)",
        "widget": "slider",
        "advanced": true,
        "visibleWhen": {
          "method": [
            "spotless"
          ]
        }
      }
    },
    "pel": {
      "type": "enum",
      "default": "2",
      "options": [
        "1",
        "2",
        "4"
      ],
      "optional": true,
      "ui": {
        "label": "Sub-pixel Accuracy",
        "description": "Motion estimation precision (1=pixel, 2=half-pixel, 4=quarter-pixel)",
        "widget": "dropdown",
        "optionLabels": {
          "1": "1 (pixel)",
          "2": "2 (half-pixel)",
          "4": "4 (quarter-pixel)"
        },
        "advanced": true,
        "visibleWhen": {
          "method": [
            "spotless"
          ]
        }
      }
    },
    "method": {
      "type": "enum",
      "default": "spotless",
      "options": [
        "spotless",
        "removeDirt"
      ],
      "ui": {
        "label": "Method",
        "description": "SpotLess is more thorough. RemoveDirt is far quicker and nearly as good.",
        "widget": "dropdown"
      }
    },
    "rdNoise": {
      "type": "integer",
      "default": 50,
      "min": 0,
      "max": 255,
      "step": 5,
      "ui": {
        "label": "Spot size",
        "description": "How large a difference from its neighbours counts as dirt.",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "removeDirt"
          ]
        }
      }
    },
    "rdNoisy": {
      "type": "integer",
      "default": 12,
      "min": 0,
      "max": 64,
      "step": 1,
      "ui": {
        "label": "Spot density",
        "description": "How many neighbouring pixels must agree before it is treated as damage.",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "removeDirt"
          ]
        }
      }
    },
    "rdGmthreshold": {
      "type": "integer",
      "default": 70,
      "min": 0,
      "max": 255,
      "step": 5,
      "ui": {
        "label": "Motion tolerance",
        "description": "How much of the frame may be moving before it is treated as motion rather than damage.",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "removeDirt"
          ]
        }
      }
    },
    "rdDist": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 8,
      "step": 1,
      "ui": {
        "label": "Spread",
        "description": "How far around a detected spot to repair.",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "removeDirt"
          ]
        }
      }
    },
    "rdPostDenoise": {
      "type": "boolean",
      "default": false,
      "ui": {
        "label": "Extra smoothing pass",
        "description": "The traditional final smoothing step. Off by default — measured, it alone triples the damage to clean parts of the picture.",
        "widget": "checkbox",
        "visibleWhen": {
          "method": [
            "removeDirt"
          ]
        }
      }
    }
  },
  "ui": {
    "sections": [
      {
        "title": "SpotLess settings",
        "parameters": [
          "chroma",
          "rec"
        ],
        "expanded": true
      },
      {
        "title": "Motion analysis",
        "parameters": [
          "blksize",
          "overlap",
          "pel"
        ],
        "expanded": false
      },
      {
        "title": "RemoveDirt settings",
        "parameters": [
          "rdNoise",
          "rdNoisy",
          "rdGmthreshold"
        ],
        "expanded": true
      },
      {
        "title": "RemoveDirt tuning",
        "parameters": [
          "rdDist",
          "rdPostDenoise"
        ],
        "expanded": false,
        "advancedOnly": true
      }
    ]
  },
  "codeTemplate": {
    "imports": [],
    "generate": "custom"
  }
}
