{
  "$schema": "https://vapourbox.app/schemas/filter-v1.json",
  "id": "dehalo",
  "version": "1.1.0",
  "name": "Dehalo",
  "description": "Remove halo, ringing and ghosting around edges",
  "longDescription": "Removes the bright outline that sits alongside high-contrast edges — the ringing left by over-sharpening, upscaling or heavy compression.\n\nUse it when edges look traced with a light pen: common on VHS run through a sharpening time-base corrector, and on upscaled or hard-compressed material. Apply it after deinterlacing and denoising. Too much strength eats the fine detail right next to the edge.\n\nThe two Vinverse methods target a different artifact: the vertical comb or ghost residue a deinterlacer leaves behind. They blur vertically, so only run them on progressive frames — after the deinterlace pass, never instead of it.",
  "category": "cleanup",
  "icon": "blur_off",
  "order": 4,
  "dependencies": {
    "plugins": [
      "havsfunc"
    ],
    "vs_plugins": [
      "RemoveGrainVS.dll",
      "CTMF.dll"
    ],
    "optional": [
      "libawarpsharp2.dll"
    ]
  },
  "methods": [
    {
      "id": "dehalo_alpha",
      "name": "DeHalo Alpha",
      "description": "Best first choice. Handles the bright outlines left by over-sharpening on most sources",
      "function": "haf.DeHalo_alpha",
      "parameters": [
        "rx",
        "ry",
        "darkStr",
        "brightStr",
        "lowSens",
        "highSens",
        "superSample"
      ]
    },
    {
      "id": "fine_dehalo",
      "name": "Fine Dehalo",
      "description": "Masked, so it keeps real edges better than DeHalo Alpha. Slower. Use when DeHalo Alpha softens the picture",
      "function": "haf.FineDehalo",
      "parameters": [
        "rx",
        "ry",
        "darkStr",
        "brightStr",
        "lowThreshold",
        "highThreshold",
        "limitLow",
        "limitHigh",
        "contra",
        "excludeCloseEdges",
        "edgeProc"
      ]
    },
    {
      "id": "fine_dehalo2",
      "name": "Fine Dehalo 2",
      "description": "Removes the ringing left on sharp edges. A follow-up pass — run it after Fine Dehalo, not instead of it",
      "function": "haf.FineDehalo2",
      "parameters": [],
      "advancedOnly": true
    },
    {
      "id": "yahr",
      "name": "YAHR",
      "description": "Fastest option, and good on halos that come with ringing. Can soften fine texture",
      "function": "haf.YAHR",
      "parameters": [
        "yahrBlur",
        "yahrDepth"
      ]
    },
    {
      "id": "edge_cleaner",
      "name": "Edge Cleaner",
      "description": "Cleans edge noise and weak halos by warping edges (aWarpSharp2). Niche — for line art rather than live action",
      "function": "haf.EdgeCleaner",
      "parameters": [
        "edgeStrength",
        "edgeRepair",
        "edgeRepairMode",
        "edgeSmallMode",
        "edgeHotPixels"
      ],
      "advancedOnly": true
    },
    {
      "id": "vinverse",
      "name": "Vinverse (de-ghost)",
      "description": "Removes comb/ghost residue left by deinterlacing. Also offered in Chroma Fixes, which is the better place for it",
      "function": "haf.Vinverse",
      "parameters": [
        "vinverseStrength",
        "vinverseAmount",
        "vinverseChroma"
      ],
      "advancedOnly": true
    },
    {
      "id": "vinverse2",
      "name": "Vinverse 2 (de-ghost)",
      "description": "Like Vinverse but keeps more vertical detail. Also offered in Chroma Fixes",
      "function": "haf.Vinverse2",
      "parameters": [
        "vinverseStrength",
        "vinverseAmount",
        "vinverseChroma"
      ],
      "advancedOnly": true
    },
    {
      "id": "hq_deringmod",
      "name": "HQDeringmod",
      "description": "Removes ringing — the overshoot immediately beside an edge — while a mask protects the edge itself. A narrower target than dehalo, for over-sharpened or heavily compressed sources",
      "function": "haf.HQDeringmod",
      "parameters": [
        "deringMrad",
        "deringMsmooth",
        "deringMthr",
        "deringThr",
        "deringDarkthr"
      ]
    }
  ],
  "parameters": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "ui": {
        "hidden": true
      }
    },
    "method": {
      "type": "enum",
      "default": "dehalo_alpha",
      "options": [
        "dehalo_alpha",
        "fine_dehalo",
        "fine_dehalo2",
        "yahr",
        "edge_cleaner",
        "vinverse",
        "vinverse2",
        "hq_deringmod"
      ],
      "ui": {
        "hidden": true
      }
    },
    "rx": {
      "type": "number",
      "default": 2.0,
      "min": 1.0,
      "max": 3.0,
      "step": 0.1,
      "optional": true,
      "vapoursynth": {
        "name": "rx"
      },
      "ui": {
        "label": "Horizontal Radius",
        "description": "Horizontal radius for halo detection",
        "widget": "slider",
        "precision": 1,
        "visibleWhen": {
          "method": [
            "dehalo_alpha",
            "fine_dehalo"
          ]
        }
      }
    },
    "ry": {
      "type": "number",
      "default": 2.0,
      "min": 1.0,
      "max": 3.0,
      "step": 0.1,
      "optional": true,
      "vapoursynth": {
        "name": "ry"
      },
      "ui": {
        "label": "Vertical Radius",
        "description": "Vertical radius for halo detection",
        "widget": "slider",
        "precision": 1,
        "visibleWhen": {
          "method": [
            "dehalo_alpha",
            "fine_dehalo"
          ]
        }
      }
    },
    "darkStr": {
      "type": "number",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "optional": true,
      "vapoursynth": {
        "name": "darkstr"
      },
      "ui": {
        "label": "Dark Halo Strength",
        "description": "Strength of dark halo removal. Above 1.0 overshoots — it pushes past the original pixel rather than blending back to it",
        "widget": "slider",
        "precision": 2,
        "visibleWhen": {
          "method": [
            "dehalo_alpha",
            "fine_dehalo"
          ]
        }
      }
    },
    "brightStr": {
      "type": "number",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.05,
      "optional": true,
      "vapoursynth": {
        "name": "brightstr"
      },
      "ui": {
        "label": "Bright Halo Strength",
        "description": "Strength of bright halo removal. Above 1.0 overshoots — it pushes past the original pixel rather than blending back to it",
        "widget": "slider",
        "precision": 2,
        "visibleWhen": {
          "method": [
            "dehalo_alpha",
            "fine_dehalo"
          ]
        }
      }
    },
    "lowSens": {
      "type": "integer",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 5,
      "optional": true,
      "vapoursynth": {
        "name": "lowsens"
      },
      "ui": {
        "label": "Low Sensitivity",
        "description": "How aggressively strong halos are treated. Lower keeps more of them",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "dehalo_alpha"
          ]
        }
      }
    },
    "highSens": {
      "type": "integer",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 5,
      "optional": true,
      "vapoursynth": {
        "name": "highsens"
      },
      "ui": {
        "label": "High Sensitivity",
        "description": "How aggressively weak halos are treated. Higher catches subtler haloing",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "dehalo_alpha"
          ]
        }
      }
    },
    "superSample": {
      "type": "number",
      "default": 1.5,
      "min": 1.0,
      "max": 2.5,
      "step": 0.1,
      "optional": true,
      "vapoursynth": {
        "name": "ss"
      },
      "ui": {
        "label": "Supersampling",
        "description": "Work at this multiple of the frame size for cleaner edges. Costs time; 1.0 disables it",
        "widget": "slider",
        "precision": 1,
        "visibleWhen": {
          "method": [
            "dehalo_alpha"
          ]
        }
      }
    },
    "lowThreshold": {
      "type": "integer",
      "default": 80,
      "min": 0,
      "max": 200,
      "step": 1,
      "optional": true,
      "vapoursynth": {
        "name": "thmi"
      },
      "ui": {
        "label": "Edge Mask Low",
        "description": "Minimum edge strength that counts as an edge",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "fine_dehalo"
          ]
        }
      }
    },
    "highThreshold": {
      "type": "integer",
      "default": 128,
      "min": 0,
      "max": 255,
      "step": 1,
      "optional": true,
      "vapoursynth": {
        "name": "thma"
      },
      "ui": {
        "label": "Edge Mask High",
        "description": "Edge strength treated as a definite edge",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "fine_dehalo"
          ]
        }
      }
    },
    "limitLow": {
      "type": "integer",
      "default": 50,
      "min": 0,
      "max": 255,
      "step": 5,
      "optional": true,
      "vapoursynth": {
        "name": "thlimi"
      },
      "ui": {
        "label": "Limit Low",
        "description": "Below this edge strength, dehaloing is fully limited — protects faint detail",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "fine_dehalo"
          ]
        }
      }
    },
    "limitHigh": {
      "type": "integer",
      "default": 100,
      "min": 0,
      "max": 255,
      "step": 5,
      "optional": true,
      "vapoursynth": {
        "name": "thlima"
      },
      "ui": {
        "label": "Limit High",
        "description": "Above this edge strength, dehaloing is applied in full",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "fine_dehalo"
          ]
        }
      }
    },
    "contra": {
      "type": "number",
      "default": 0.0,
      "min": 0.0,
      "max": 2.0,
      "step": 0.1,
      "optional": true,
      "vapoursynth": {
        "name": "contra"
      },
      "ui": {
        "label": "Contra-Sharpening",
        "description": "Restore some edge sharpness lost to dehaloing. 0 disables it",
        "widget": "slider",
        "precision": 1,
        "visibleWhen": {
          "method": [
            "fine_dehalo"
          ]
        }
      }
    },
    "excludeCloseEdges": {
      "type": "boolean",
      "default": true,
      "optional": true,
      "vapoursynth": {
        "name": "excl"
      },
      "ui": {
        "label": "Exclude Close Edges",
        "description": "Skip areas where edges are too close together to tell halo from detail",
        "visibleWhen": {
          "method": [
            "fine_dehalo"
          ]
        }
      }
    },
    "edgeProc": {
      "type": "number",
      "default": 0.0,
      "min": 0.0,
      "max": 1.0,
      "step": 0.05,
      "optional": true,
      "vapoursynth": {
        "name": "edgeproc"
      },
      "ui": {
        "label": "Edge Processing",
        "description": "Add some edge detail back into the mask. 0 disables it",
        "widget": "slider",
        "precision": 2,
        "visibleWhen": {
          "method": [
            "fine_dehalo"
          ]
        }
      }
    },
    "yahrBlur": {
      "type": "integer",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1,
      "optional": true,
      "vapoursynth": {
        "name": "blur"
      },
      "ui": {
        "label": "Blur",
        "description": "Blur amount for YAHR",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "yahr"
          ]
        }
      }
    },
    "yahrDepth": {
      "type": "integer",
      "default": 32,
      "min": 8,
      "max": 128,
      "step": 8,
      "optional": true,
      "vapoursynth": {
        "name": "depth"
      },
      "ui": {
        "label": "Depth",
        "description": "Processing depth for YAHR",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "yahr"
          ]
        }
      }
    },
    "edgeStrength": {
      "type": "integer",
      "default": 10,
      "min": 1,
      "max": 50,
      "step": 1,
      "optional": true,
      "vapoursynth": {
        "name": "strength"
      },
      "ui": {
        "label": "Edge Strength",
        "description": "How hard to clean along edges",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "edge_cleaner"
          ]
        }
      }
    },
    "edgeRepair": {
      "type": "boolean",
      "default": true,
      "optional": true,
      "vapoursynth": {
        "name": "rep"
      },
      "ui": {
        "label": "Repair",
        "description": "Constrain the warped result against the source. Leave on unless you want the raw effect",
        "visibleWhen": {
          "method": [
            "edge_cleaner"
          ]
        }
      }
    },
    "edgeRepairMode": {
      "type": "enum",
      "default": "17",
      "options": [
        "1",
        "16",
        "17",
        "18"
      ],
      "optional": true,
      "vapoursynth": {
        "name": "rmode"
      },
      "ui": {
        "label": "Repair Mode",
        "description": "1 is very mild and good for halos; 17 keeps the least haloing; 16 and 18 preserve edge structure but keep more halo",
        "widget": "dropdown",
        "visibleWhen": {
          "method": [
            "edge_cleaner"
          ]
        }
      }
    },
    "edgeSmallMode": {
      "type": "enum",
      "default": "0",
      "options": [
        "0",
        "1"
      ],
      "optional": true,
      "vapoursynth": {
        "name": "smode"
      },
      "ui": {
        "label": "Small Particles",
        "description": "1 protects small bright particles (stars, specular highlights) via RemoveGrain; 0 disables that",
        "widget": "dropdown",
        "visibleWhen": {
          "method": [
            "edge_cleaner"
          ]
        }
      }
    },
    "edgeHotPixels": {
      "type": "boolean",
      "default": false,
      "optional": true,
      "vapoursynth": {
        "name": "hot"
      },
      "ui": {
        "label": "Remove Hot Pixels",
        "description": "Also remove isolated bright pixels",
        "visibleWhen": {
          "method": [
            "edge_cleaner"
          ]
        }
      }
    },
    "vinverseStrength": {
      "type": "number",
      "default": 2.7,
      "min": 0.0,
      "max": 8.0,
      "step": 0.1,
      "optional": true,
      "vapoursynth": {
        "name": "sstr"
      },
      "ui": {
        "label": "Strength",
        "description": "How hard to attack the residual comb. Higher removes more ghosting and more vertical detail with it",
        "widget": "slider",
        "precision": 1,
        "visibleWhen": {
          "method": [
            "vinverse",
            "vinverse2"
          ]
        }
      }
    },
    "vinverseAmount": {
      "type": "integer",
      "default": 255,
      "min": 0,
      "max": 255,
      "step": 5,
      "optional": true,
      "vapoursynth": {
        "name": "amnt"
      },
      "ui": {
        "label": "Max Change",
        "description": "Cap on how far any pixel may move. 255 is unlimited; lower values keep the result closer to the source",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "vinverse",
            "vinverse2"
          ]
        }
      }
    },
    "vinverseChroma": {
      "type": "boolean",
      "default": true,
      "optional": true,
      "vapoursynth": {
        "name": "chroma"
      },
      "ui": {
        "label": "Process Chroma",
        "description": "Also treat the colour planes. Turn off to leave colour untouched",
        "visibleWhen": {
          "method": [
            "vinverse",
            "vinverse2"
          ]
        }
      }
    },
    "deringMrad": {
      "type": "integer",
      "default": 1,
      "min": 1,
      "max": 3,
      "step": 1,
      "optional": true,
      "ui": {
        "label": "Ring Radius",
        "description": "How wide a band beside each edge to treat",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "hq_deringmod"
          ]
        }
      }
    },
    "deringMsmooth": {
      "type": "integer",
      "default": 1,
      "min": 0,
      "max": 4,
      "step": 1,
      "optional": true,
      "ui": {
        "label": "Mask Smoothing",
        "description": "Softens where the mask takes effect",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "hq_deringmod"
          ]
        }
      }
    },
    "deringMthr": {
      "type": "integer",
      "default": 60,
      "min": 0,
      "max": 255,
      "step": 5,
      "optional": true,
      "ui": {
        "label": "Edge Threshold",
        "description": "Lower finds more edges to protect",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "hq_deringmod"
          ]
        }
      }
    },
    "deringThr": {
      "type": "number",
      "default": 12.0,
      "min": 0.0,
      "max": 64.0,
      "step": 0.5,
      "optional": true,
      "ui": {
        "label": "Limit",
        "description": "How far a pixel may be changed, in 8-bit levels",
        "widget": "slider",
        "precision": 1,
        "visibleWhen": {
          "method": [
            "hq_deringmod"
          ]
        }
      }
    },
    "deringDarkthr": {
      "type": "number",
      "default": 3.0,
      "min": 0.0,
      "max": 64.0,
      "step": 0.5,
      "optional": true,
      "ui": {
        "label": "Dark Limit",
        "description": "Separate limit for the dark side of an edge. Left off, havsfunc uses a quarter of the main limit",
        "widget": "slider",
        "precision": 1,
        "visibleWhen": {
          "method": [
            "hq_deringmod"
          ]
        }
      }
    }
  },
  "ui": {
    "sections": [
      {
        "title": "Settings",
        "parameters": [
          "rx",
          "ry",
          "darkStr",
          "brightStr",
          "lowThreshold",
          "highThreshold",
          "yahrBlur",
          "yahrDepth",
          "edgeStrength",
          "edgeRepair",
          "vinverseStrength",
          "vinverseAmount",
          "vinverseChroma",
          "deringMrad",
          "deringMsmooth",
          "deringThr"
        ],
        "expanded": true
      },
      {
        "title": "Advanced",
        "parameters": [
          "lowSens",
          "highSens",
          "superSample",
          "limitLow",
          "limitHigh",
          "contra",
          "excludeCloseEdges",
          "edgeProc",
          "edgeRepairMode",
          "edgeSmallMode",
          "edgeHotPixels",
          "deringMthr",
          "deringDarkthr"
        ],
        "expanded": false,
        "advancedOnly": true
      }
    ]
  },
  "codeTemplate": {
    "imports": [
      "import havsfunc as haf"
    ],
    "generate": "method"
  }
}
