{
  "$schema": "https://vapourbox.app/schemas/filter-v1.json",
  "id": "deinterlace",
  "version": "1.0.0",
  "name": "Deinterlace",
  "description": "QTGMC deinterlacing or IVTC inverse telecine",
  "category": "deinterlace",
  "icon": "layers",
  "order": 1,
  "dependencies": {
    "plugins": [
      "havsfunc",
      "mvsfunc"
    ],
    "vs_plugins": [
      "libmvtools.dll",
      "EEDI3m.dll",
      "libvs_znedi3.dll",
      "libfmtconv.dll",
      "ffms2.dll",
      "VIVTC.dll"
    ]
  },
  "methods": [
    {
      "id": "qtgmc",
      "name": "QTGMC",
      "description": "High-quality deinterlacing using motion compensation",
      "function": "haf.QTGMC",
      "parameters": [
        "preset",
        "tff",
        "inputType",
        "fpsDivisor",
        "tr0",
        "tr1",
        "tr2",
        "rep0",
        "rep1",
        "rep2",
        "repChroma",
        "ediMode",
        "nnSize",
        "nnNeurons",
        "ediQual",
        "ediMaxD",
        "chromaEdi",
        "blockSize",
        "overlap",
        "search",
        "searchParam",
        "pelSearch",
        "chromaMotion",
        "trueMotion",
        "lambda",
        "lsad",
        "pNew",
        "pLevel",
        "globalMotion",
        "dct",
        "subPel",
        "subPelInterp",
        "thSad1",
        "thSad2",
        "thScd1",
        "thScd2",
        "sharpness",
        "sMode",
        "slMode",
        "slRad",
        "sOvs",
        "svThin",
        "sbb",
        "srchClipPp",
        "noiseProcess",
        "ezDenoise",
        "ezKeepGrain",
        "noisePreset",
        "denoiser",
        "fftThreads",
        "denoiseMc",
        "noiseTr",
        "sigma",
        "chromaNoise",
        "showNoise",
        "grainRestore",
        "noiseRestore",
        "noiseDeint",
        "stabilizeNoise",
        "sourceMatch",
        "matchPreset",
        "matchEdi",
        "matchPreset2",
        "matchEdi2",
        "matchTr2",
        "matchEnhance",
        "lossless",
        "border",
        "precise",
        "forceTr",
        "str",
        "amp",
        "fastMa",
        "eSearchP",
        "refineMotion",
        "opencl",
        "device"
      ]
    },
    {
      "id": "ivtc",
      "name": "IVTC",
      "description": "Inverse telecine for DVD sources with 3:2 pulldown (29.97i → 23.976p)",
      "function": "core.vivtc.VFM + core.vivtc.VDecimate",
      "parameters": [
        "ivtcOrder",
        "ivtcMode",
        "ivtcCthresh",
        "ivtcMi",
        "ivtcBlockX",
        "ivtcBlockY",
        "ivtcCycle",
        "ivtcDupthresh",
        "ivtcScthresh"
      ]
    }
  ],
  "parameters": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "ui": {
        "hidden": true
      }
    },
    "method": {
      "type": "enum",
      "default": "qtgmc",
      "options": [
        "qtgmc",
        "ivtc"
      ],
      "ui": {
        "hidden": true
      }
    },
    "preset": {
      "type": "enum",
      "default": "Slower",
      "options": [
        "Placebo",
        "Very Slow",
        "Slower",
        "Slow",
        "Medium",
        "Fast",
        "Faster",
        "Very Fast",
        "Super Fast",
        "Ultra Fast",
        "Draft"
      ],
      "vapoursynth": {
        "name": "Preset"
      },
      "ui": {
        "label": "Preset",
        "description": "Quality/speed tradeoff preset",
        "widget": "dropdown",
        "visibleWhen": {
          "method": [
            "qtgmc"
          ]
        }
      }
    },
    "tff": {
      "type": "boolean",
      "default": true,
      "vapoursynth": {
        "name": "TFF"
      },
      "ui": {
        "label": "Field Order",
        "description": "Field order of the interlaced source. TFF (Top Field First) is most common for DVD/broadcast. BFF (Bottom Field First) is used by some DV camcorders and older captures. Auto-detected from source metadata when available.",
        "hidden": true,
        "booleanLabels": {
          "true": "Top Field First (TFF)",
          "false": "Bottom Field First (BFF)"
        }
      }
    },
    "inputType": {
      "type": "integer",
      "default": 0,
      "min": 0,
      "max": 3,
      "vapoursynth": {
        "name": "InputType"
      },
      "ui": {
        "label": "Input Type",
        "description": "0: Interlaced | 1: Telecined (3:2 pulldown) | 2: Progressive | 3: Double-rate progressive",
        "widget": "slider",
        "visibleWhen": {
          "method": [
            "qtgmc"
          ]
        }
      }
    },
    "fpsDivisor": {
      "type": "integer",
