{
  "_comment": "What each output container (ContainerFormat) holds and how it times it: the one statement, read by both sides (task #49, widening task #39's audio table). worker/build.rs compiles it into the worker (src/models/output_capabilities.rs); app/tool/generate_output_capabilities.dart writes app/lib/models/output_capabilities_table.dart from it. output_capabilities_test.dart muxes every video, audioConvert and audioCopy row with the bundled FFmpeg, both ways. See CLAUDE.md, 'Output capabilities: one table'.",
  "_traits": {
    "storesStreamStart": "the container records where each stream starts (an edit list, Matroska block times); AVI plays everything from 0, so a late picture, a copy pre-roll and encoder priming all land at 0",
    "videoTimeBase": "'frame': one tick per frame (AVI; a late picture became a 1/600 time base with null frames, task #30); 'timestamps': per-packet timestamps",
    "fieldFlag": "the container can say a picture is interlaced and which field is first (MOV/MP4 fiel atom, Matroska FieldOrder); a codec without a flag of its own goes out unflagged where this is false",
    "audioPacketTiming": "'blockAlign': players time a VBR audio chunk by nBlockAlign (AVI, task #41); 'timestamps': per-packet timestamps",
    "restoredPassthrough": "the codec (ffmpeg name) of a restored track under Passthrough, unless the video is an editing intermediate (always pcm_s24le)",
    "subtitles": "'copy': SRT muxed as is; 'movText': converted to mov_text; 'none': the container takes no subtitle stream",
    "isoMedia": "an ISO base media file (MP4/MOV): -movflags +faststart and the hvc1 tag apply",
    "verdict": "'offered': the app offers it; 'notOffered': FFmpeg writes it but the app keeps it off (the worker runs it with a warning: a hand-written job, or a test that needs it, e.g. HuffYUV's MOV fiel atom); 'refused': the worker refuses it with the row's message, because FFmpeg cannot write it or (ffmpegWrites: true) writes a file few players read. muxEncoder: the encoder the mux check uses in place of one a CI runner lacks (same codec id)"
  },
  "containers": [
    {
      "container": "mp4",
      "storesStreamStart": true,
      "videoTimeBase": "timestamps",
      "fieldFlag": true,
      "audioPacketTiming": "timestamps",
